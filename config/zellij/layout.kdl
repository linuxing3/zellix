layout {
    // antigravity风格的AI编辑器布局
    tab name="editor" {
        pane split_direction="vertical" {
            
            pane size="75%" {
                editor_pane
            }
            
            pane name="terminal" borderless=true {
                start_suspended true
                command "zsh"
                args "-i"
            }
        }
        
    }
    

    tab name="www" {
        pane borderless=true name="www" {
            command "elinks"
            start_suspended true
            args "https://duckduckgo.org"
        }
    }
    
    shell_tab name="shell"
    
    // tab template
    tab_template name="shell_tab" {
        pane split_direction="vertical" {
            pane size="70%" borderless=true command="zsh" name="shell" {
                start_suspended true
                args "-i"
            }
            pane size="30%" borderless=true command="zsh" name="shell" {
                start_suspended true
                args "-i"
            }
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    
    // editor template
    pane_template name="editor_pane" {
        command "nu"
        args "-c" "nu ($env.ZELLIX_PATH + '/helix.nu')"
    }
    
    // default tab
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
}

